<% if comment.published? %>
  <%# Who and when first, then what they said, then what you can do about it.
      Replies sit indented under their parent with a thread line.
      Only the comment's own part is cached: adding a reply does not change the
      parent's updated_at, so replies rendered inside the parent's cached block
      went missing until the parent itself was edited. %>
  <div class="comment" id="comment-<%=comment.id %>" data-comment-id="<%= comment.id %>">
    <%# Delete and Report depend on who is looking, so that is in the key too;
        otherwise the first viewer's version was served to everyone. %>
    <% is_author = comment.user_id == current_user.id %>
    <% cache([I18n.locale, "comment_v3", comment, comment.state, comment.user.try(:trust_tier), is_author, current_user.admin?]) do %>
      <div class="comment-meta">
        <strong class="comment-author"><%= link_to comment.user.try(:username) || comment.user.try(:id), pins_path(user: comment.user) %></strong><%= render 'shared/trust_badge', user: comment.user %>
        <span class="comment-meta-separator" aria-hidden="true">·</span>
        <%# Full date server-side and as the tooltip; pin_age.js swaps in a short "3d ago". %>
        <% posted = l(comment.updated_at, format: :long) %>
        <%= content_tag(:time, posted, datetime: comment.updated_at.utc.iso8601, title: posted, class: 'pin-age comment-age') %>
        <% if is_author || current_user.admin? %>
          <%= link_to "×", comment_path(comment), :method => :delete, :remote => true, data: {confirm: t('public.pin.remove_confirm')}, :disable_with => "×", :class => 'close' %>
        <% end %>
      </div>
      <div class="comment-body"><%= comment.body %></div>
      <div class="comment-actions">
        <%# The comment's own commentable: right on pin, procedure and surgeon pages alike. %>
        <% commentable = comment.commentable %>
        <%= link_to t('public.pin.reply'), new_comment_path(commentable_id: commentable.try(:id), commentable_type: commentable.try(:class), parent_id: comment.id), remote: true, class: 'comment-reply' %>
        <%= link_to(t('public.pin.report'), comment_flags_path(comment), :method => :post, remote: true, class: "flag-comment", "data-comment-id" => comment.id,
          title: t('public.pin.report'), data: { confirm: t('public.pin.report_comment_confirm'), reported_label: t('public.pin.reported') }) unless is_author %>
      </div>
    <% end %>
    <% if comment.children.present? %>
      <div class="comment-replies">
        <%= render :partial => 'comments/comment', :collection => comment.children, :as => :comment %>
      </div>
    <% end %>
    <%# After the replies: comments/new.js.erb puts the reply form in the last
        .reply-target inside this comment, and comments.js.coffee moves a
        posted reply into .comment-replies. %>
    <div class="reply-target"></div>
  </div>
<% end %>
