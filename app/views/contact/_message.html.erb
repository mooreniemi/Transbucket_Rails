<div class="col-md-6 center">
  <div class="well">
    <%= form_for @message, url: contact_path do |form| %>
    <fieldset class="fields">
      <div class="field">
        <% if user_signed_in? %>
        <%= form.hidden_field :email, value: User.find(current_user).email %>
        <% else %>
        <div class="input-group padded_nicely">
          <span class="input-group-addon">@</span>
          <%= form.email_field :email, placeholder: t('public.extra.return_email'), class: "form-control", autofocus: true %>
        </div>
        <% end %>
      </div>
      <div class="input-group padded_nicely">
        <%= form.text_field :subject, placeholder: t('public.extra.subject'), class: "form-control" %>
        <span class="input-group-addon"><%= fa_icon 'bullhorn' %></span>
      </div>
      <%= form.text_area :body, class: "form-control", rows:"4", placeholder: t('public.extra.contact_message') %>
    </fieldset>
  </div>

  <%= form.submit t('public.extra.send'), class: "btn btn-primary" %>
  <% end %>
</div>
