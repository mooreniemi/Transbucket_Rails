<% require 'devise/version' %>
<p><%= t('.greeting', recipient: @email) %></p>

<% if @resource.confirmation_reminder %>
  <p><%= t('.reminder_notice') %></p>
<% end %>

<p><%= t('.instruction') %></p>
<p><%= link_to t('.action'), confirmation_url(@resource, :locale => I18n.locale, :confirmation_token => @token, :utm_medium => 'email', :utm_source => 'devise', :utm_campaign => 'confirmation') %></p>

<% if @resource.confirmation_reminder %>
  <p><%= t('.reminder_help') %></p>
<% end %>
