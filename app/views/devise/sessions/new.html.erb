<% title t('account_menu.login') %>
<%# Mobile-first login: labelled fields, a show/hide password toggle, "forgot
    password" beside the password, remember-me on its own tappable row, one
    full-width button, and a clear route to sign up. %>
<div class="auth-page">
  <div class="auth-card">
    <h1 class="auth-title"><%= t('account_menu.login') %></h1>

    <div id="flash-message">
      <% flash.each do |name, msg| %>
        <%= content_tag(:div, msg, class: "alert #{name.to_s == 'alert' ? 'alert-danger' : 'alert-info'}", id: "flash-#{name}") %>
      <% end %>
    </div>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'auth-form' }) do |f| %>
      <%= f.error_notification %>

      <div class="auth-field">
        <%= label_tag :user_login, t('public.auth.username_or_email') %>
        <%= f.text_field :login, class: 'form-control', autocomplete: 'username', autocapitalize: 'none', autocorrect: 'off', spellcheck: 'false', enterkeyhint: 'next', data: { auth_autofocus: true } %>
      </div>

      <div class="auth-field">
        <%= label_tag :user_password, t('public.auth.password') %>
        <div class="auth-password">
          <%= f.password_field :password, class: 'form-control', autocomplete: 'current-password', autocapitalize: 'none', autocorrect: 'off', spellcheck: 'false', enterkeyhint: 'go' %>
          <%= render 'devise/shared/password_toggle', input_id: 'user_password' %>
        </div>
        <p class="auth-forgot">
          <%= link_to t('devise.shared.links.forgot_your_password'), new_password_path(resource_name) %>
        </p>
      </div>

      <div class="auth-remember">
        <%= f.check_box :remember_me %>
        <%= label_tag :user_remember_me, t('activerecord.attributes.user.remember_me') %>
      </div>

      <%= f.submit t('account_menu.login'), class: 'btn btn-primary btn-lg btn-block auth-submit', data: { disable_with: t('public.auth.submitting') } %>
    <% end %>

    <div class="auth-switch auth-switch-cta">
      <p><%= t('public.auth.new_here') %></p>
      <%= link_to t('account_menu.register'), new_registration_path(resource_name), class: 'btn btn-default btn-lg btn-block' %>
    </div>
    <p class="auth-help">
      <%= link_to t('devise.shared.links.didn_t_receive_confirmation_instructions'), new_confirmation_path(resource_name) %>
    </p>
  </div>
</div>
