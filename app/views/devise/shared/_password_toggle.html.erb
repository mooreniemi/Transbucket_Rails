<%# Show/hide toggle for a password field. Hidden until auth_forms.js runs, so
    it never appears as a dead button without JavaScript. Icon-only so it works
    in every language; the label is for assistive tech and the tooltip. %>
<button type="button" class="auth-password-toggle" hidden
        data-auth-password-toggle
        aria-controls="<%= input_id %>" aria-pressed="false"
        aria-label="<%= t('public.auth.show_password') %>" title="<%= t('public.auth.show_password') %>"
        data-show-label="<%= t('public.auth.show_password') %>" data-hide-label="<%= t('public.auth.hide_password') %>">
  <%= fa_icon 'eye' %>
</button>
