<% if user_signed_in? %>
  <li class="dropdown">
    <a href="#" class="dropdown-toggle" data-toggle="dropdown"><%= I18n.t(".header.account")%> <span class="caret"></span></a>
    <ul class="dropdown-menu" role="menu">
      <li><%= link_to t('account_menu.my_account'),  edit_user_registration_path %></li>
      <li><%= link_to t('account_menu.logout'),  destroy_user_session_path, method: :delete %></li>
    </ul>
  </li>
<% else %>
  <li><%= link_to t('account_menu.login'), new_user_session_path, class: "nav-auth-link" %></li>
  <li><%= link_to t('account_menu.register'), register_path, class: "nav-auth-link nav-auth-link-register" %></li>
<% end %>
