<div class="footer submission_well">
  <% cache("#{I18n.locale}_#{Date.today.year}") do %>
    <small> &nbsp;
      <%= link_to I18n.t('.footer.about'),  about_path %> |
      <%= link_to I18n.t('.footer.tos'), terms_path %> |
      <%= link_to I18n.t('.footer.pp'), privacy_path %> |
      <%= fa_icon "facebook", class: 'yellow' %> <a href="https://www.facebook.com/transbucket">Transbucket</a> <%= fa_icon "twitter", class: 'yellow' %> <a href="https://twitter.com/TransBucket">@TransBucket</a> |
      <%= I18n.t('.footer.discord_prefix') %> <a href="https://discord.gg/fRW4RnPqgv">Transbucket.com Discord</a>! |
      <span class="locale-picker"><%= I18n.t('.locale.label') %>:
        <% ApplicationController::SUPPORTED_LOCALES.each_with_index do |locale, index| %>
          <%= ' | ' unless index.zero? %><%= link_to I18n.t("locale.names.#{locale}"), url_for(locale: locale) %>
        <% end %>
      </span>
    </small>
  <% end %>
</div>
