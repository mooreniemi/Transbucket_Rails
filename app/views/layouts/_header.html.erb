<% logged_out = !user_signed_in? %>
<nav class="navbar navbar-default navbar-fixed-top<%= logged_out ? ' navbar-anon' : ' navbar-signed-in' %>" role="navigation">
  <div class="container-fluid">
    <!-- Brand and toggle get grouped for better mobile display -->
    <div class="navbar-header">
      <%# Logged-out visitors only have three links plus login/register, so on
          phones they are shown inline (see logged_out_header.css.scss) and
          there is no menu to hide them in. %>
      <% unless logged_out %>
        <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1" <%= track_click_attribute_string(:menu, :header) %>>
          <span class="sr-only"><%= t('public.extra.navigation_toggle') %></span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
        </button>
      <% end %>
      <%= link_to image_tag("small_logo.png", :size => "16x16", :alt => t('public.extra.logo_alt')), root_path, :class => "navbar-brand" %>
      <% if logged_out %>
        <a class="navbar-brand navbar-brand-text" href="<%= root_path %>">Transbucket.com</a>
      <% end %>
    </div>
    <%# Search lives outside the collapsible menu so phones can keep it in the
        top bar instead of hiding it behind the hamburger. On desktop the
        float layout puts it in the same place as before. %>
    <% if user_signed_in? %>
      <%= render partial: 'layouts/search' %>
    <% end %>
    <!-- Collect the nav links, forms, and other content for toggling -->
    <div class="<%= 'collapse ' unless logged_out %>navbar-collapse" id="bs-example-navbar-collapse-1">
      <ul class="nav navbar-nav">
        <% if user_signed_in? %>
          <%= render partial: 'layouts/logged_in' %>
        <% else %>
          <li>
            <%= link_to I18n.t('.header.news'),  newsfeed_path, track_click_attributes(:news, :header) %>
          </li>
          <li>
            <%= link_to I18n.t('.header.procedures'),  procedures_path, track_click_attributes(:procedures, :header) %>
          </li>
          <li>
            <%= link_to I18n.t('.header.surgeons'),  surgeons_path, track_click_attributes(:surgeons, :header) %>
          </li>
        <% end %>
      </ul>
      <% if logged_out %>
        <%# Two lists (not one) so phones can put login/register beside the
            brand and the language switcher beside the page links. Auth comes
            first in the source because .navbar-right floats right on desktop,
            which keeps the visual order as language | login | register. %>
        <ul class="nav navbar-nav navbar-right navbar-anon-auth">
          <%= render partial: 'layouts/account_menu' %>
        </ul>
        <ul class="nav navbar-nav navbar-right navbar-anon-locale">
          <%= render partial: 'layouts/locale_switcher' %>
        </ul>
      <% else %>
        <ul class="nav navbar-nav navbar-right">
          <%= render partial: 'layouts/locale_switcher' %>
          <%= render partial: 'layouts/account_menu' %>
        </ul>
      <% end %>
    </div><!-- /.navbar-collapse -->
  </div><!-- /.container-fluid -->
</nav>
