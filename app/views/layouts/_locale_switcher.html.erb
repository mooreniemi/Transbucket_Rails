<li class="dropdown">
  <a href="#" class="dropdown-toggle" data-toggle="dropdown">
    <%= fa_icon "globe" %> <span class="locale-code"><%= I18n.locale.to_s.upcase %></span> <span class="caret"></span>
  </a>
  <ul class="dropdown-menu dropdown-menu-right" role="menu">
    <% ApplicationController::SUPPORTED_LOCALES.each do |locale| %>
      <li class="<%= 'active' if locale == I18n.locale.to_s %>">
        <%= link_to I18n.t("locale.names.#{locale}"), url_for(locale: locale) %>
      </li>
    <% end %>
  </ul>
</li>
