<%# Signed-in navigation, in the order people reach for it. This is also the top
    of the phone menu, so the most-used destinations come first. %>
<li>
  <%= link_to I18n.t(".header.submissions"), pins_path %>
</li>
<li>
  <%= link_to I18n.t('.header.procedures'), procedures_path %>
</li>
<li>
  <%= link_to I18n.t('.header.surgeons'), surgeons_path %>
</li>
<% comparison_type = controller_name == 'surgeons' || params[:type] == 'surgeons' ? 'surgeons' : 'procedures' %>
<li>
  <%= link_to t('comparison.title', default: 'Compare'), compare_path(type: comparison_type) %>
</li>
<% unless current_user.gender.cis? %>
  <li>
    <%= link_to "#{I18n.t(".header.add")} #{fa_icon('plus-circle', class: 'yellow')}".html_safe, new_pin_path %>
  </li>
<% end %>
<li>
  <%= link_to I18n.t('.header.news'), newsfeed_path %>
</li>
<% if current_user.admin? %>
  <li class="bg-danger">
    <%= link_to 'MQ', queendom_path, title: 'Moderation queue', aria: { label: 'Moderation queue' } %>
  </li>
<% end %>
