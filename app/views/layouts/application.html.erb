<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track' => true %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track' => true %>
    <%= csrf_meta_tags %>
    <%= display_meta_tags :reverse => true, :site => 'Transbucket.com', :description => I18n.t('site.description'), :canonical => "#{request.base_url}#{request.path}", :og => { :type => 'website', :site_name => 'Transbucket.com' }, :twitter => { :card => 'summary' } %>
    <%= locale_alternate_links %>
    <%= json_ld_tag(website_json_ld) %>
    <%= json_ld_tag(organization_json_ld) %>
    <%= yield :head %>
    <% if Rails.env.production? %>
      <!-- Global site tag (gtag.js) - Google Analytics -->
      <script async src="https://www.googletagmanager.com/gtag/js?id=UA-40933997-1"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'UA-40933997-1');
      </script>
    <% end %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
  </head>
  <body>
    <%= render 'layouts/header' %>
    <div class="container">
      <% if user_signed_in? %>
        <div id="flash-message">
          <% flash.each do |name, msg| %>
            <%= content_tag(:div, msg, class: "alert", id: "flash-#{name}") %>
          <% end %>
        </div>
      <% end %>
      <%= yield %>
    </div>
    <%= any_login_here if Rails.env.development? %>
    <%= render 'layouts/footer' %>
  </body>
</html>
