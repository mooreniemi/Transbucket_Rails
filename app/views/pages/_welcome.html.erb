<% title I18n.t('.homepage.title') %>
<div class="row">
  <div class="col-md-10 col-md-offset-1 center">
    <h1 class="welcome-title"><%= I18n.t('.homepage.title') %></h1>
    <p class="lead"><%= I18n.t('.homepage.intro') %></p>
  </div>
</div>
<%# On phones only the middle block (the keys logo, linking to register) is shown,
    so it lands above the fold; the other two are desktop-only (hidden-xs). %>
<div class="row homepage-cta-row text-center">
  <div class="col-md-4 homepage-cta hidden-xs">
    <h3><%= I18n.t('.homepage.considering') %></h3>
    <%= link_to (image_tag("dysphoria2.png", :size => "200x200", :alt => "dysphoria", :padding => "10")), register_path, track_click_attributes(:home_cta, :home) %>
  </div>
  <div class="col-md-4 homepage-cta">
    <h3><%= I18n.t('.homepage.join') %></h3>
    <%= link_to (image_tag("dysphoria3.png", :size => "200x200", :alt => "key", :padding => "10")), register_path, track_click_attributes(:home_cta, :home) %>
  </div>
  <div class="col-md-4 homepage-cta hidden-xs">
    <h3><%= I18n.t('.homepage.register') %></h3>
    <%= link_to (image_tag("register.png", :size => "200x200", :alt => "key", :padding => "10")), register_path, track_click_attributes(:home_cta, :home) %>
  </div>
</div>
