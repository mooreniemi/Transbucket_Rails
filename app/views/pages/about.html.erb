<link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet">
<% seo_meta description: t('about.meta_description') %>
<% title t('about.title') %>
<div class="row">
  <div class="col-md-12 center">
    <h1><%= t('about.title') %></h1>
  </div>
  <div class="padded_nicely col-md-6 center" style="background: url('<%= image_url("dysphoria2.png", :size => "400x400", :alt => "key", :padding => "10") %>') no-repeat top center; height:200px;">
  </div>
</div>
<div class="row nice-font">
  <div class="faq_item col-md-6 center">
    <p class="lead"><strong>TransBucket.com</strong> <%= t('about.origin', transster_link: link_to('Transster.com', 'http://wayback.archive.org/web/20010815000000*/http://www.transster.com')).html_safe %></p>
  </div>
  &nbsp;
  <div class="faq_item col-md-6 center">
    <h3><%= t('about.welcome_heading') %></h3>
    <p><%= t('about.welcome') %></p>
    <p><mark><%= t('about.community_note') %></mark></p>
    <h3><%= t('about.funding_heading') %></h3>
    <p><%= t('about.funding') %></p>
    <h3><%= t('about.help_heading') %></h3>
    <p><%= t('about.help') %> <%= link_to t('about.github_link'), 'https://github.com/mooreniemi/Transbucket_Rails' %>!</p>
  </div>
  &nbsp;
  <div class="faq_item col-md-6 center">
    <p class="lead"><%= t('about.contact', contact_link: link_to(t('about.contact_form'), contact_path), email_link: mail_to('webmaster@transbucket.com'), facebook_link: link_to('Facebook', 'https://www.facebook.com/transbucket'), twitter_link: link_to('Twitter', 'https://twitter.com/transbucket')).html_safe %></p>
  </div>
</div>
