<% page_title = I18n.t('newsfeed.title') %>
<% seo_meta title: page_title, description: I18n.t('newsfeed.description') %>
<%= render partial: 'ads/test1' %>
<% title page_title %>
<h1><%= I18n.t('newsfeed.title') %></h1>
<div class="center newsfeed">
  <% @newsfeed_entries.each do |entry| %>
    <article class="rss_item newsfeed-entry">
      <p class="newsfeed-body">
        <%= entry[:body] %>
        <% if entry[:links].present? %>
          (<%= entry[:links].map { |link| link_to(link[0], link[1]) }.join(' / ').html_safe %>)
        <% end %>
      </p>
      <% entry[:images].to_a.each do |image| %>
        <%= image_tag image, class: 'newsfeed-screenshot', alt: t('newsfeed.comparison_image_alt', default: 'Example comparison page using fictional demo data') %>
      <% end %>
      <p class="newsfeed-date"><%= entry[:date] %></p>
    </article>
  <% end %>
</div>
