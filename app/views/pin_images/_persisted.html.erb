<div id="persisted_pins" class="col-md-6">
  <% @pin.pin_images.reject{|i| i if i.id.nil?}.each do |image| %>
  <div class="thumbnail">
    <%= link_to(fa_icon("trash-o"), pin_image_path(image.id), method: "delete", remote: true, data: { confirm: t('public.confirmations.are_you_sure'), disable_with: t('public.actions.deleting') }) %>
    <%= image_tag image.photo.url(:thumb) %>
  </div>
  <div class="caption">
    <div class="input-group">
      <%= text_field_tag :caption, image.caption, placeholder: t('public.extra.caption') %>
      <%= link_to(t('public.actions.update_caption').html_safe, pin_image_path(image.id), method: "patch", remote: true, data: { disable_with: t('public.actions.updating') }) %>
    </div>
  </div>
  <% end %>
</div>
