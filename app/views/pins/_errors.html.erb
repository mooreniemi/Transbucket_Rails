<% messages = form.errors.full_messages %>
<div id="error_explanation" class="submission_well<% if messages.empty? %> hide<% end %>">
  <% if messages.any? %>
    <h2><%= pluralize(messages.length, "error") %> prohibited this pin from being saved:</h2>
  <% end %>
  <ul>
    <% messages.each do |msg| %>
    <li><%= msg %></li>
    <% end %>
  </ul>
</div>
