<%# The cards and the page links. Also rendered on its own (PinsController#index
    with ?fragment=1) for feed_scroll.js, which only needs the next cards and
    the next link, not the header, filters and footer around them. %>
<div id="pins">
  <% @presenter.pins.each_with_index do |item, index| %>
    <% if @presenter.mixed_feed? %>
      <%= render partial: 'feed_item', locals: { item: item, event_context: @presenter.list_event_context.merge(rank: @presenter.rank_offset + index + 1) } %>
    <% else %>
      <%= render partial: 'pin', locals: { pin: item, event_context: @presenter.list_event_context.merge(rank: @presenter.rank_offset + index + 1) } %>
    <% end %>
  <% end %>
</div>
<%# On phones feed_scroll.js hides the page links and loads the next page as you
    scroll; these are its status lines. pin_viewer.js reads the close label. %>
<div id="paginator"
  data-loading-label="<%= t('directory.loading_more') %>"
  data-error-label="<%= t('directory.load_more_failed') %>"
  data-done-label="<%= t('directory.end_of_feed') %>"
  data-close-label="<%= t('directory.close_pin') %>">
  <%= will_paginate @presenter.pins, renderer: BootstrapPagination::Rails, params: { fragment: nil } unless @presenter.pins.empty? %>
</div>
