<!-- TODO convert this from form to just pure remote calls? -->
<%= form_tag pins_path, :method => 'get', :id => 'filter_dropdown' do %>
  <%= submit_tag t('filter_menu.apply'), id: 'submit-filter', class: 'btn' %>
  <%= link_to t('filter_menu.clear'), "#", id: 'clear-filter', class: 'btn' %>
  <% scope_options = Pin::SCOPES.map { |scope| [t("filter_scopes.#{scope}"), scope] } %>
  <%= select_tag :scope, options_for_select(scope_options, params[:scope]), {multiple: true, class: "chosen-select", 'data-placeholder' => t('filter_menu.scope')} %>
      <%= select_tag :procedure, options_from_collection_for_select(Procedure.order('name asc'), "id", "localized_name", (params[:procedure].present? ? params[:procedure] : nil)), {multiple: true, class: "chosen-select", 'data-placeholder' => t('filter_menu.procedure')} %>
  <%= select_tag :surgeon, options_from_collection_for_select(Surgeon.order('last_name asc'), "id", "to_s", (params[:surgeon].present? ? params[:surgeon] : nil)), {multiple: true, class: "chosen-select", 'data-placeholder' => t('filter_menu.surgeon')} %>
  <%= hidden_field_tag :user, params[:user] if params[:user].present? %>
<% end %>
