<fieldset>
  <% if !f.object.new_record? %>
  <%= image_tag f.object.photo.url, alt: f.object.caption.presence || t('public.extra.image_caption') %>
  <% end %>

  <%= f.file_field :photo %>
  <%= f.label :caption, t('public.extra.image_caption') %>
  <%= f.text_field :caption %>
  <%= delete_photo(f) %>
</fieldset>
