<% if pin.published? %>
<div class="item" data-pin-id="<%= pin.id %>" itemscope>
  <div class="panel panel-default">
    <div class="panel-body">
    <%= render partial: "latest_comment_snippet", locals: { pin: pin } if @comments.map(&:commentable_id).include?(pin.id) %>
    <% cache([I18n.locale, pin, @safe_mode]) do %>
      <div class="image" itemprop="image">
        <%= link_to (image_tag pin.cover_image(@safe_mode).url(:medium)), pin %>
      </div>
      <p class="description" itemprop="description">
        <%= pin.try(:procedure).try(:localized_name) %> <%= t('public.pin.by') %> <strong><%= pin.unknown_surgeon? ? t('public.pin.unknown') : t('public.pin.doctor_prefix') + pin.surgeon.to_s %></strong>
      </p>
    <% end %>
    <!-- end cache fragment  -->
    </div>
    <!-- panel body end -->
    <div class="panel-footer">
      <div class="actions">
        <label class="label-with-popover" data-placement="right" data-content="Flags from 3 different users will remove content pending review by a moderator." data-title="Flag this content." data-trigger="hover">
          <%= link_to(fa_icon("flag"), pin_flags_path(pin), method: :post, remote: true, "data-pin-id" => pin.id, class: "flag-pin") + " | " unless current_user == pin.user %>
        </label>
      <% if current_user == pin.user || current_user.admin? %>
        <%= link_to fa_icon("pencil-square-o"), edit_pin_path(pin) %>
        | <%= link_to fa_icon("trash-o"), pin, method: :delete, data: { confirm: t('public.confirmations.are_you_sure') } %>
      <% if pin.pending? %>
        | <%= link_to 'Remove Flag', remove_pin_flag_path(pin), remote: true %>
      <% end %>
      <!-- end if pin pending -->
      <% end %>
      <!-- end if user can edit -->
        <%= t('public.pin.updated', time: distance_of_time_in_words(Time.now, pin.updated_at)) %>
      </div>
      <!-- end footer actions -->
    </div>
    <!-- end panel footer -->
  </div>
</div>
<% end %>
