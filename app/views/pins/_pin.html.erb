<% if Rails.env.production? && ads_allowed? && rand(1..15) == 7 %>
  <% Rails.logger.debug "Serving ad with #{pin.id}" %>
  <div class="item ad pin-ad-slot" aria-hidden="true">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js"></script>
    <!-- test1 -->
    <ins class="adsbygoogle"
         style="display:block"
         data-ad-client="ca-pub-3154444439610781"
         data-ad-slot="3311943876"
         data-ad-format="auto"
         data-full-width-responsive="true"></ins>
    <script>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
<% end %>
<!-- end ad snippet -->
<% if pin.published? %>
<div class="item" data-pin-id="<%= pin.id %>" itemscope>
  <% event_context ||= {} %>
  <%= content_tag :div, '', hidden: true, 'data-content-event' => true,
    'data-content-event-url' => content_events_path,
    'data-content-event-batch-url' => batch_content_events_path,
    'data-content-type' => 'Pin',
    'data-content-id' => pin.id,
    'data-event-type' => 'impression',
    'data-event-context' => event_context.to_json %>
  <div class="panel panel-default">
    <div class="panel-body">
    <% latest_new_comment = (@latest_new_comments || {})[pin.id] %>
    <%= render partial: "latest_comment_snippet", locals: { pin: pin, comment: latest_new_comment, event_context: event_context } if latest_new_comment %>
    <% cache([I18n.locale, pin, @safe_mode]) do %>
      <div class="image pin-card-image<%= ' safe-blur' if @safe_mode %>" itemprop="image">
        <%= link_to (image_tag pin.cover_image.url(:medium), alt: pin.procedure.try(:localized_name)), pin,
          'data-content-event-open' => true,
          'data-content-event-url' => content_events_path,
          'data-content-type' => 'Pin',
          'data-content-id' => pin.id,
          'data-event-context' => event_context.to_json %>
        <%= render 'shared/safe_reveal' if @safe_mode %>
      </div>
      <p class="description" itemprop="description">
        <%= pin.try(:procedure).try(:localized_name) %> <%= t('public.pin.by') %> <strong><%= pin.unknown_surgeon? ? t('public.pin.unknown') : "#{t('public.pin.doctor_prefix')}#{link_to pin.surgeon.to_s, surgeon_path(id: pin.surgeon.id)}".html_safe %></strong>
      </p>
    <% end %>
    <!-- end cache fragment  -->
    </div>
    <!-- panel body end -->
    <div class="panel-footer">
      <div class="actions pin-actions">
        <%# Left: what you can do. Right: how fresh it is and how much discussion it has.
            Every icon has a text label (for screen readers and long-press) since phones
            have no hover, and reporting asks first: it used to fire on a single tap. %>
        <span class="pin-actions-icons">
          <% unless current_user == pin.user %>
            <label class="label-with-popover" data-placement="right" data-content="Flags from 3 different users will remove content pending review by a moderator." data-title="Flag this content." data-trigger="hover">
              <%= link_to fa_icon("flag"), pin_flags_path(pin), method: :post, remote: true, "data-pin-id" => pin.id, class: "flag-pin",
                title: t('public.pin.report'), 'aria-label' => t('public.pin.report'), data: { confirm: t('public.pin.report_confirm'), reported_label: t('public.pin.reported') } %>
            </label>
          <% end %>
          <% if current_user == pin.user || current_user.admin? %>
            <%= link_to fa_icon("pencil-square-o"), edit_pin_path(pin), title: t('public.pin.edit_post'), 'aria-label' => t('public.pin.edit_post') %>
            <%= link_to fa_icon("trash-o"), pin, method: :delete, data: { confirm: t('public.confirmations.are_you_sure') },
              title: t('public.pin.delete_post'), 'aria-label' => t('public.pin.delete_post') %>
            <% if pin.pending? %>
              <%= link_to 'Remove Flag', remove_pin_flag_path(pin), remote: true %>
            <% end %>
            <!-- end if pin pending -->
          <% end %>
          <!-- end if user can edit -->
        </span>
        <span class="pin-actions-meta">
          <%# Full sentence server-side; pin_age.js swaps in a short localized "3h ago". %>
          <% updated_text = t('public.pin.updated', time: distance_of_time_in_words(Time.now, pin.updated_at)) %>
          <%= content_tag :time, updated_text, class: 'pin-age', datetime: pin.updated_at.utc.iso8601, title: updated_text %>
          <% comment_count = (@comment_counts || {})[pin.id].to_i %>
          <%# Outside the fragment cache above, so a new comment shows up straight away. %>
          <% if comment_count > 0 %>
            <%= link_to pin_path(pin, anchor: 'comments-container'), class: 'pin-comment-count',
              title: t('public.pin.comments_label', count: comment_count),
              'aria-label' => t('public.pin.comments_label', count: comment_count),
              'data-content-event-open' => true,
              'data-content-event-url' => content_events_path,
              'data-content-type' => 'Pin',
              'data-content-id' => pin.id,
              'data-event-context' => event_context.to_json do %>
              <%= fa_icon('comment-o') %> <span><%= comment_count %></span>
            <% end %>
          <% end %>
        </span>
      </div>
      <!-- end footer actions -->
    </div>
    <!-- end panel footer -->
  </div>
</div>
<% end %>
