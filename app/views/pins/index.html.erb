<%= javascript_include_tag "pins" %>
<% if params[:query].present? || params[:surgeon].present? || params[:procedure].present? || params[:complication].present? || params[:user].present? || params[:satisfaction].present? || params[:sensation].present? %>
  <% seo_meta description: t('directory.search_description'), noindex: true %>
<% else %>
  <% seo_meta description: t('directory.submissions_intro') %>
<% end %>
<% if params[:query].present? %>
  <% title "#{t('directory.search_results')}: #{params[:query]}" %>
<% else %>
  <% title @presenter.showing_for_you? ? t('directory.for_you', default: 'For You') : t('directory.recent_submissions') %>
<% end %>
<% if params[:query].present? %>
  <h1 class="page-title-compact"><%= t('directory.search_results') %></h1>
<% else %>
  <%# On phones the heading and blurb are visually hidden (see feed_mobile.css.scss) so the photos lead; they stay for screen readers and SEO. %>
  <h1 class="feed-title"><%= @presenter.showing_for_you? ? t('directory.for_you', default: 'For You') : t('directory.recent_submissions') %></h1>
  <p class="lead feed-intro"><%= t('directory.submissions_intro') %></p>
<% end %>
<%# Toolbar: Filter, + Discussion, + Submission. Filter and + Discussion each
    open a form above the feed (one at a time, feed_toolbar.js); + Submission
    is the submission form. Recent / For You is a choice inside Filter. On
    phones the same three float at the bottom once this row scrolls away. %>
<% filter_count = active_filter_count %>
<%# ?compose=1 (Start a discussion in the menu) opens the discussion form instead. %>
<% composing = params[:compose].present? %>
<div class="feed-toolbar" id="feed-toolbar"><%= render 'pins/toolbar_actions', filter_count: filter_count, composing: composing, dock: false %></div>
<div id="feed-filter-panel" class="feed-toolbar-panel collapse<%= ' in' if filter_count > 0 && !composing %>">
  <%= render partial: 'pins/filter_controls' %>
</div>
<div id="feed-compose-panel" class="feed-toolbar-panel collapse<%= ' in' if composing %>">
  <div class="feed-filter-card feed-compose-card">
    <%= render 'discussions/form', discussion: Discussion.new(category: 'discussion', visibility: 'everyone'), in_feed: true %>
  </div>
</div>
<%# Phones: the toolbar again, at the bottom of the screen, once the one above
    has scrolled away (feed_toolbar.js shows it). Its buttons scroll back up
    and open the same forms. %>
<nav class="feed-dock" aria-label="<%= t('directory.feed_actions', default: 'Feed actions') %>" hidden><%= render 'pins/toolbar_actions', filter_count: filter_count, composing: composing, dock: true %></nav>
<%= render 'pins/feed_page' %>
