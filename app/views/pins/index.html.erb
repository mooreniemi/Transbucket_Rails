<%= javascript_include_tag "pins" %>
<% if params[:query].present? || params[:surgeon].present? || params[:procedure].present? || params[:complication].present? || params[:user].present? %>
  <% seo_meta description: 'Search Transbucket submissions by procedure, surgeon, complication, or user.', noindex: true %>
<% else %>
  <% seo_meta description: 'Browse recent Transbucket submissions and compare real procedure outcomes.' %>
<% end %>
<% if params[:query].present? %>
  <% title "Search Result for '#{params[:query]}'" %>
<% else %>
  <% title 'Recent Submissions' %>
<% end %>
<% if params[:query].present? %>
  <h1>Search Results</h1>
<% else %>
  <h1>Recent Submissions</h1>
  <p class="lead">Browse recent submissions or use the search box to find a procedure, surgeon, or complication.</p>
<% end %>
<div id="pins">
  <%= render @presenter.pins %>
</div>
<div id="paginator">
  <%= will_paginate @presenter.pins, renderer: BootstrapPagination::Rails unless @presenter.pins.empty? %>
</div>
