<%= javascript_include_tag "pins" %>
<% if params[:query].present? || params[:surgeon].present? || params[:procedure].present? || params[:complication].present? || params[:user].present? %>
  <% seo_meta description: t('directory.search_description'), noindex: true %>
<% else %>
  <% seo_meta description: t('directory.submissions_intro') %>
<% end %>
<% if params[:query].present? %>
  <% title "#{t('directory.search_results')}: #{params[:query]}" %>
<% else %>
  <% title t('directory.recent_submissions') %>
<% end %>
<% if params[:query].present? %>
  <h1><%= t('directory.search_results') %></h1>
<% else %>
  <h1><%= t('directory.recent_submissions') %></h1>
  <p class="lead"><%= t('directory.submissions_intro') %></p>
<% end %>
<div id="pins">
  <%= render @presenter.pins %>
</div>
<div id="paginator">
  <%= will_paginate @presenter.pins, renderer: BootstrapPagination::Rails unless @presenter.pins.empty? %>
</div>
