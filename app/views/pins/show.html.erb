<% surgeon_name = @pin.unknown_surgeon? ? t('public.pin.unknown_surgeon') : t('public.pin.doctor_prefix') + @pin.surgeon.to_s %>
<% pin_title = "#{@pin.procedure.localized_name} #{t('public.pin.by')} #{surgeon_name}" %>
<% pin_image = @pin.pin_images.find { |image| image.photo_file_size.present? } %>
<% seo_meta title: pin_title, description: "#{pin_title} on Transbucket.", canonical: pin_url(id: @pin.id), image: (pin_image ? image_url(pin_image.photo) : nil), type: 'article' %>
<% title pin_title %>
<% can_edit_pin = current_user == @pin.user || current_user.admin? %>
<%= content_tag :div, '', hidden: true, 'data-content-event' => true,
  'data-content-event-url' => content_events_path,
  'data-content-type' => 'Pin',
  'data-content-id' => @pin.id,
  'data-event-type' => 'view' %>
<% json_ld_tag(
  {
    '@context' => 'https://schema.org',
    '@type' => 'CreativeWork',
    'name' => pin_title,
    'description' => @pin.details,
    'url' => pin_url(id: @pin.id)
  }.compact
) %>
<% json_ld_tag(
  {
    '@context' => 'https://schema.org',
    '@type' => 'BreadcrumbList',
    'itemListElement' => [
      { '@type' => 'ListItem', 'position' => 1, 'name' => t('header.home'), 'item' => root_url },
      { '@type' => 'ListItem', 'position' => 2, 'name' => t('header.submissions'), 'item' => pins_url },
      { '@type' => 'ListItem', 'position' => 3, 'name' => pin_title, 'item' => pin_url(id: @pin.id) }
    ]
  }
) %>
<h1 class="pin-page-title"><%= pin_title %></h1>
<% cache([I18n.locale, "pin_show", @safe_mode, @pin, @pin.pin_images.map(&:id), @pin.pin_images.maximum(:updated_at), can_edit_pin]) do %>
  <div class="row pin-show-grid">
    <div class="col-md-7">
      <div class="pin-gallery-panel">
        <% for pinimage in @pin.pin_images.reject {|p| p.photo_file_size.nil?} do %>
          <div class="thumbnail pin-gallery-item">
            <div class="pin-gallery-photo<%= ' safe-blur' if @safe_mode %>">
              <%= image_tag pinimage.photo, class: 'pin-gallery-image', alt: pinimage.caption.presence || pin_title %>
              <%= render 'shared/safe_reveal' if @safe_mode %>
            </div>
            <div class="caption pin-gallery-caption">
              <%= pinimage.caption.to_s %>
            </div>
          </div>
        <% end %>
        <div class="pin-page-actions">
          <%= link_to fa_icon("arrow-left"), pins_path, title: t('header.submissions'), aria: { label: t('header.submissions') } %>
        <% if can_edit_pin %>
          | <%= link_to fa_icon("pencil-square-o"), edit_pin_path(id: @pin.id), title: t('public.extra.editing_submission'), aria: { label: t('public.extra.editing_submission') } %>
      <% end %>
        </div>
    </div>
  </div>
  <div class="col-md-5">
    <dl class="dl-horizontal pin-meta">
      <dt>
        <%= fa_icon "user-md" %> <%= t('public.pin.surgeon') %>
      </dt>
      <dd>
        <%= link_to @pin.unknown_surgeon? ? t('public.pin.unknown') : @pin.surgeon.to_s, surgeon_path(id: @pin.surgeon.id) %>
      </dd>
      <dt>
        <%= fa_icon "plus-square" %> <%= t('public.pin.procedure') %>
      </dt>
      <dd>
        <%= link_to @pin.procedure.localized_name, procedure_path(@pin.procedure) %>
      </dd>
      <dt>
          <%= fa_icon "usd" %> <%= t('public.pin.cost') %>
      </dt>
      <dd>
        <%= number_with_delimiter(@pin.cost) %>
      </dd>
      <% if @pin.complications.present? %>
        <dt>
          <%= fa_icon "medkit" %> <%= t('public.pin.complications') %>
        </dt>
        <dd>
          <% @pin.complications.each do |complication| %>
            <%= link_to complication, pins_path(complication: complication.name) %>
          <% end %>
        </dd>
      <% end %>
      <% if @pin.revision %>
        <dt>
          <%= fa_icon "exclamation-circle" %> <%= t('public.pin.wants_revision') %>
        </dt>
        <dd></dd>
      <% end %>
      <% if @pin.sensation.present? %>
        <dt><%= t('public.pin.post_op_sensation') %></dt>
        <dd class="pin-rating-value" aria-label="<%= @pin.sensation %>/5">
          <span class="pin-rating-stars" aria-hidden="true"><%= (1..5).map { |star| fa_icon(star <= @pin.sensation.to_i ? 'star' : 'star-o') }.join.html_safe %></span>
          <span class="pin-rating-score"><%= @pin.sensation %>/5</span>
        </dd>
      <% end %>
      <% if @pin.satisfaction.present? %>
        <dt><%= t('public.pin.post_op_satisfaction') %></dt>
        <dd class="pin-rating-value" aria-label="<%= @pin.satisfaction %>/5">
          <span class="pin-rating-stars" aria-hidden="true"><%= (1..5).map { |star| fa_icon(star <= @pin.satisfaction.to_i ? 'star' : 'star-o') }.join.html_safe %></span>
          <span class="pin-rating-score"><%= @pin.satisfaction %>/5</span>
        </dd>
      <% end %>
      <% if @pin.user.present? %>
        <dt><%= t('public.pin.submitter') %></dt>
        <dd><strong><%= link_to @pin.user.username.presence || @pin.user.id, pins_path(user: @pin.user) %></strong></dd>
      <% end %>
    </dl>
    <% if @pin.details.present? %>
      <div id="details" class="pin-details">
        <%= fa_icon "quote-left" %>
        <%= simple_format(@pin.details) %>
      </div>
    <% end %>
  </div>
  <br clear="both" />
  </div>
<% end %>
<div id="comments-container">
  <h4><%= fa_icon("comments-o") %> <%= t('public.pin.discussion') %></h4>
  <%= render :partial => 'comments/comment', :collection => @comments, :as => :comment %>
    <h5><%= t('public.pin.respect_pronouns') %> <%= uses_pronouns(@pin.user.try(:gender)) %>.</h5>
  <%= link_to "<h5>#{fa_icon("comments-o")} #{t('public.pin.add_thread')}</h5>".html_safe, new_comment_path(commentable_id: @pin.id, commentable_type: "Pin"), remote: true %>
  <div id="commentable" class="reply-target">
  </div>
</div>
