<tr itemscope itemtype="https://schema.org/MedicalProcedure"
    data-sort-name="<%= procedure.localized_name %>"
    data-sort-submissions="<%= @pins_per_procedure[procedure.id] || 0 %>"
    data-sort-satisfaction="<%= avg_satisfaction || '' %>"
    data-sort-sensation="<%= avg_sensation || '' %>"
    data-sort-discussions="<%= @comments_per_procedure[procedure.id] || 0 %>">
  <td data-label="<%= t('directory.name') %>"><%= link_to procedure.localized_name.titleize, procedure_path(procedure) %></td>
  <% if user_signed_in? %>
  <td data-label="<%= t('directory.submissions') %>"><%= link_to @pins_per_procedure[procedure.id] || 0, pins_path(procedure: procedure.id) %></td>
<% else %>
  <td data-label="<%= t('directory.submissions') %>"><%= link_to t('directory.register_to_see_more'), register_path  %></td>
  <% end %>
  <td data-label="<%= t('directory.average_satisfaction') %>"><%= avg_satisfaction && avg_satisfaction.round(1) %></td>
  <td data-label="<%= t('directory.average_sensation') %>"><%= avg_sensation && avg_sensation.round(1) %></td>
  <td data-label="<%= t('directory.discussion_threads') %>"><%= @comments_per_procedure[procedure.id] || 0 %></td>
</tr>
