<% title t('comparison.procedures_title', default: 'Compare procedures') %>
<% seo_meta description: t('comparison.procedures_description', default: 'Compare procedure rating distributions on Transbucket.') %>
<%= render partial: 'shared/comparison_form', locals: { resource_type: 'procedures', options: @comparison_options, first: @first_procedure, second: @second_procedure, label_method: :localized_name, action: compare_procedures_path } %>
<% if @first_procedure && @second_procedure && @first_procedure != @second_procedure %>
  <% cache([I18n.locale, 'procedure-rating-comparison', @first_procedure, @second_procedure]) do %>
    <div class="rating-comparison-results">
      <% [[:sensation, @first_procedure, @second_procedure], [:satisfaction, @first_procedure, @second_procedure]].each do |rating, first, second| %>
        <section class="rating-comparison-row" aria-labelledby="procedure-comparison-<%= rating %>-heading">
          <h2 id="procedure-comparison-<%= rating %>-heading"><%= t("public.rating.#{rating}.distribution") %></h2>
          <div class="row">
            <% [[first, 'first'], [second, 'second']].each do |procedure, position| %>
              <% values = @comparison_data[procedure] %>
              <div class="col-md-6" id="procedure-comparison-<%= position %>-<%= rating %>">
                <h3><%= link_to procedure.localized_name, procedure_path(procedure) %></h3>
                <%= render partial: 'shared/rating_distribution', locals: { distribution: values[:distributions], average: values[:averages][rating], rating: rating, title: t("public.rating.#{rating}.distribution"), scope_params: { procedure: procedure.id }, heading_id: "procedure-comparison-#{position}-#{rating}" } %>
              </div>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% end %>
<% end %>
