<%= render partial: 'ads/test1' %>
<% seo_meta description: t('directory.procedures_intro') %>
<% title t('directory.procedures_title') %>
<% json_ld_tag(
  {
    '@context' => 'https://schema.org',
    '@type' => 'ItemList',
    'name' => t('directory.procedures_title'),
    'itemListElement' => @procedures.each_with_index.map do |procedure, index|
      {
        '@type' => 'ListItem',
        'position' => index + 1,
        'url' => procedure_url(procedure),
        'name' => procedure.localized_name
      }
    end
  }
) %>
<div class="row">
  <div class="col-md-12 center">
    <h1><%= t('directory.procedures_title') %></h1>
    <p class="lead"><%= t('directory.procedures_intro') %></p>
  </div>
</div>
<div id="procedures" style="background-color:#ffffff">
  <table class="table table-hover table-bordered sticky-header-table sortable-directory-table" data-sortable-directory="procedures" bgcolor="#ffffcc">
    <thead>
      <tr>
        <th><button type="button" class="directory-sort-button" data-sort-key="name" aria-sort="none"><%= t('directory.name') %> <%= fa_icon('sort', aria: { hidden: true }) %></button></th>
        <th><button type="button" class="directory-sort-button" data-sort-key="submissions" aria-sort="none"><%= t('directory.submissions') %> <%= fa_icon('sort', aria: { hidden: true }) %></button></th>
        <th><button type="button" class="directory-sort-button" data-sort-key="satisfaction" aria-sort="none"><%= t('directory.average_satisfaction') %> <%= fa_icon('sort', aria: { hidden: true }) %></button></th>
        <th><button type="button" class="directory-sort-button" data-sort-key="sensation" aria-sort="none"><%= t('directory.average_sensation') %> <%= fa_icon('sort', aria: { hidden: true }) %></button></th>
        <th><button type="button" class="directory-sort-button" data-sort-key="discussions" aria-sort="none"><%= t('directory.discussion_threads') %> <%= fa_icon('sort', aria: { hidden: true }) %></button></th>
      </tr>
    </thead>
    <tbody>
      <% @procedures.each do |procedure| %>
        <%= render partial: 'procedures/procedure', locals: {
          procedure: procedure,
          avg_satisfaction: @avg_satisfaction_by_procedure[procedure.id],
          avg_sensation: @avg_sensation_by_procedure[procedure.id]
        } %>
      <% end %>
    </tbody>
  </table>
</div>
