<% first_complications = first_stats[:complications].index_by { |complication| complication[:name] } %>
<% second_complications = second_stats[:complications].index_by { |complication| complication[:name] } %>
<% complication_names = (first_complications.keys | second_complications.keys).sort_by do |name|
  first_rate = first_complications[name].try(:[], :rate).to_i
  second_rate = second_complications[name].try(:[], :rate).to_i
  shared = first_complications.key?(name) && second_complications.key?(name)
  [shared ? 0 : 1, -(first_rate + second_rate), name.downcase]
end %>

<section class="comparison-complications" aria-labelledby="comparison-complications-heading">
  <h2 id="comparison-complications-heading"><%= t('comparison.complications', default: 'Complications') %></h2>
  <% if complication_names.present? %>
    <div class="comparison-stats-table-wrap">
      <table class="comparison-stats-table comparison-complications-table">
        <thead>
          <tr>
            <th scope="col"><%= t('comparison.complication', default: 'Complication') %></th>
            <th scope="col"><%= first_label %></th>
            <th scope="col"><%= second_label %></th>
            <th scope="col"><%= t('comparison.comparison_status', default: 'Comparison') %></th>
          </tr>
        </thead>
        <tbody>
          <% complication_names.each do |name| %>
            <% first_complication = first_complications[name] %>
            <% second_complication = second_complications[name] %>
            <% first_rate = first_complication.try(:[], :rate) %>
            <% second_rate = second_complication.try(:[], :rate) %>
            <tr>
              <th scope="row"><%= name %></th>
              <td>
                <% if first_rate.nil? %>
                  <%= t('comparison.not_reported', default: 'Not reported') %>
                <% else %>
                  <%= link_to t('comparison.complication_rate', rate: first_rate, default: '%{rate}% of submissions'), pins_path(first_filter.merge(complication: name)) %>
                <% end %>
              </td>
              <td>
                <% if second_rate.nil? %>
                  <%= t('comparison.not_reported', default: 'Not reported') %>
                <% else %>
                  <%= link_to t('comparison.complication_rate', rate: second_rate, default: '%{rate}% of submissions'), pins_path(second_filter.merge(complication: name)) %>
                <% end %>
              </td>
              <td>
                <% if first_rate && second_rate %>
                  <% difference = first_rate - second_rate %>
                  <%= t('comparison.shared_complication', default: 'Both') %>
                  <% unless difference.zero? %>
                    (<%= difference.positive? ? t('comparison.first_more_frequent', rate: difference, default: 'First +%{rate} points') : t('comparison.second_more_frequent', rate: difference.abs, default: 'Second +%{rate} points') %>)
                  <% end %>
                <% elsif first_rate %>
                  <%= t('comparison.first_only', default: 'First only') %>
                <% else %>
                  <%= t('comparison.second_only', default: 'Second only') %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p><%= t('comparison.none_reported', default: 'None reported') %></p>
  <% end %>
</section>
