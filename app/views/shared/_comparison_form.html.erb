<% options ||= [] %>
<% first ||= nil %>
<% second ||= nil %>
<% label_method ||= :to_s %>
<% action ||= '#' %>
<% scope_options ||= [] %>
<% scope_first ||= nil %>
<% scope_param ||= nil %>
<% scope_label ||= nil %>
<% scope_memberships ||= {} %>
<% deduplicate ||= true %>
<section class="rating-comparison-form" aria-labelledby="<%= resource_type %>-comparison-heading">
  <h2 id="<%= resource_type %>-comparison-heading"><%= t('comparison.title', default: 'Compare') %></h2>
  <%= form_tag action, method: :get, data: { comparison_scope_memberships: scope_memberships.to_json } do %>
    <div class="form-group">
      <%= label_tag :first_id, t('comparison.first', default: 'First') %>
      <%= select_tag :first_id, options_from_collection_for_select(options, :to_param, label_method, first.try(:to_param)), include_blank: true, required: true, class: 'form-control' %>
    </div>
    <div class="form-group">
      <%= label_tag :second_id, t('comparison.second', default: 'Second') %>
      <%= select_tag :second_id, options_from_collection_for_select(options, :to_param, label_method, second.try(:to_param)), include_blank: true, required: true, class: 'form-control' %>
    </div>
    <% if scope_param %>
      <div class="form-group">
        <%= label_tag scope_param, scope_label %>
        <%= select_tag scope_param, options_from_collection_for_select(scope_options, :to_param, label_method == :localized_name ? :to_s : :localized_name, scope_first.try(:to_param)), include_blank: true, class: 'form-control', data: { comparison_scope_select: true } %>
      </div>
    <% end %>
    <div class="comparison-actions">
      <%= hidden_field_tag :deduplicate, '0' %>
      <%= check_box_tag :deduplicate, '1', deduplicate, id: 'deduplicate_comparison' %>
      <%= label_tag :deduplicate_comparison, t('comparison.deduplicate', default: 'Group repeat submissions') %>
      <%= submit_tag t('comparison.submit', default: 'Compare'), class: 'btn btn-primary' %>
    </div>
  <% end %>
</section>
