<div id="surgeon_container" class="add-form hide">
  <div class="panel panel-default">
    <div class="panel-heading">
      <%= link_to fa_icon("times"), '#', class: 'cancel pull-right' %>
      <h3 class="panel-title"><%= t('public.form.add_surgeon') %></h3>
    </div>
    <div class="panel-body">
      <div class="input-group padded_nicely">
        <%= surgeon_form.text_field :last_name, placeholder: t('public.form.surgeon_last_name') %>
      </div>
      <div class="input-group padded_nicely">
        <%= surgeon_form.text_field :first_name, placeholder: t('public.form.surgeon_first_name') %>
      </div>
      <div class="input-group padded_nicely">
        <%= surgeon_form.text_field :url, placeholder: t('public.form.surgeon_url') %>
      </div>
      <div id="surgeon-suggestion" class="entity-suggestion hide" aria-live="polite" data-label="<%= t('public.form.similar_existing') %>" data-use="<%= t('public.form.use_existing') %>"></div>
    </div>
  </div>
</div>
