<%= render partial: 'ads/test1' %>
<% page_title = t('directory.surgeons_title') %>
<% seo_meta title: page_title, description: t('directory.surgeons_intro') %>
<% title page_title %>
<% json_ld_tag(
  {
    '@context' => 'https://schema.org',
    '@type' => 'ItemList',
    'name' => t('directory.surgeons_title'),
    'itemListElement' => @surgeons.each_with_index.map do |surgeon, index|
      {
        '@type' => 'ListItem',
        'position' => index + 1,
        'url' => surgeon_url(surgeon),
        'name' => surgeon.to_s
      }
    end
  }
) %>
<div class="row">
  <div class="col-md-12 center">
    <h1><%= t('directory.surgeons_title') %></h1>
    <p class="lead"><%= t('directory.surgeons_intro') %></p>
  </div>
</div>
<div id="surgeons" class="directory-table-wrap">
  <table class="table table-hover table-bordered sticky-header-table sortable-directory-table" data-sortable-directory="surgeons">
    <thead>
      <tr>
        <th><button type="button" class="directory-sort-button" data-sort-key="name" aria-sort="none"><%= t('directory.name') %> <%= fa_icon('sort', aria: { hidden: true }) %></button></th>
        <th><button type="button" class="directory-sort-button" data-sort-key="submissions" aria-sort="none"><%= t('directory.submissions') %> <%= fa_icon('sort', aria: { hidden: true }) %></button></th>
        <% if user_signed_in? %>
          <th><button type="button" class="directory-sort-button" data-sort-key="satisfaction" aria-sort="none"><%= t('directory.average_satisfaction') %> <%= fa_icon('sort', aria: { hidden: true }) %></button></th>
          <th><button type="button" class="directory-sort-button" data-sort-key="sensation" aria-sort="none"><%= t('directory.average_sensation') %> <%= fa_icon('sort', aria: { hidden: true }) %></button></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @surgeons.each do |surgeon| %>
      <%= render partial: 'surgeons/surgeon_row', locals: {
        surgeon: surgeon,
        pin_count: @pins_per_surgeon[surgeon.id],
        avg_satisfaction: @avg_satisfaction_by_surgeon[surgeon.id],
        avg_sensation: @avg_sensation_by_surgeon[surgeon.id]
      } %>
      <% end %>
    </tbody>
  </table>
</div>
