<%= render partial: 'ads/test1' %>
<% seo_meta description: 'Browse surgeons on Transbucket to compare linked submissions, outcomes, and discussion activity.' %>
<% title "Surgeons" %>
<% json_ld_tag(
  {
    '@context' => 'https://schema.org',
    '@type' => 'ItemList',
    'name' => 'Surgeons on Transbucket',
    'itemListElement' => @surgeons.each_with_index.map do |surgeon, index|
      {
        '@type' => 'ListItem',
        'position' => index + 1,
        'url' => surgeon_url(surgeon),
        'name' => surgeon.to_s
      }
    end
  }
) %>
<div class="row">
  <div class="col-md-12 center">
    <h1>Surgeons</h1>
    <p class="lead">Browse surgeon pages to compare linked submissions, outcomes, and discussion activity.</p>
  </div>
</div>
<div id="surgeons" style="background-color:#ffffff">
  <table class="table table-hover table-bordered" bgcolor="#ffffcc">
    <th>Name</th>
    <th>Submissions</th>
    <% @surgeons.each do |surgeon| %>
    <%= render partial: 'surgeons/surgeon_row', locals: { surgeon: surgeon, pin_count: @pins_per_surgeon[surgeon.id] } %>
    <% end %>
  </table>
</div>
