<% seo_meta description: t('directory.surgeons_intro') %>
<% title t('directory.surgeons_title') %>
<% json_ld_tag(
  {
    '@context' => 'https://schema.org',
    '@type' => 'ItemList',
    'name' => t('directory.surgeons_title'),
    'itemListElement' => @surgeons.each_with_index.map do |surgeon, index|
      {
        '@type' => 'ListItem',
        'position' => index + 1,
        'url' => surgeon_url(surgeon),
        'name' => surgeon.to_s
      }
    end
  }
) %>
<div class="row">
  <div class="col-md-12 center">
    <h1><%= t('directory.surgeons_title') %></h1>
    <p class="lead"><%= t('directory.surgeons_intro') %></p>
  </div>
</div>
<div id="surgeons" style="background-color:#ffffff">
  <table class="table table-hover table-bordered sticky-header-table" bgcolor="#ffffcc">
    <thead>
      <tr>
        <th><%= t('directory.name') %></th>
        <th><%= t('directory.submissions') %></th>
      </tr>
    </thead>
    <tbody>
      <% @surgeons.each do |surgeon| %>
      <%= render partial: 'surgeons/surgeon_row', locals: { surgeon: surgeon, pin_count: @pins_per_surgeon[surgeon.id] } %>
      <% end %>
    </tbody>
  </table>
</div>
