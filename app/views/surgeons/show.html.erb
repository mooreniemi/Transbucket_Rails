<% seo_meta description: "View #{@surgeon.to_s} submissions, outcome summaries, and discussion on Transbucket.", canonical: surgeon_url(id: @surgeon.id) %>
<% title @surgeon.to_s  %>
<% json_ld_tag(
  {
    '@context' => 'https://schema.org',
    '@type' => 'Physician',
    'name' => @surgeon.to_s,
    'url' => surgeon_url(id: @surgeon.id)
  }.compact
) %>
<% json_ld_tag(
  {
    '@context' => 'https://schema.org',
    '@type' => 'BreadcrumbList',
    'itemListElement' => [
      { '@type' => 'ListItem', 'position' => 1, 'name' => t('header.home', default: 'Home'), 'item' => root_url },
      { '@type' => 'ListItem', 'position' => 2, 'name' => t('header.surgeons'), 'item' => surgeons_url },
      { '@type' => 'ListItem', 'position' => 3, 'name' => @surgeon.to_s, 'item' => surgeon_url(id: @surgeon.id) }
    ]
  }
) %>
<% cache(@surgeon) do %>
<div itemscope itemtype="https://schema.org/Physician">
  <div class="media">
    <div class="media-left">
      <%= fa_icon "user-md", class: "fa-5x media-object" %>
    </div>
    <div class="media-body">
      <h1 class="media-heading"><%= @surgeon.to_s %></h1>
      <h4 class="media-heading">
        <%= link_to @surgeon.to_s, @surgeon.url %>
        <br><%= (fa_icon('star') * @surgeon.overall_satisfaction).html_safe unless @surgeon.overall_satisfaction.nil? %>
    </h4>
    <% if @surgeon.address %>
      <address>
        <%= @surgeon.address %><br>
        <%= @surgeon.city %>, <%= @surgeon.state %> <%= @surgeon.zip %><br>
        <%= @surgeon.country %><br>
      </address>
    <% end %>
    <% if @surgeon.notes %>
      <div class="panel panel-default">
        <div class="panel-body">
          <%= t('public.form.details') %>: <%= @surgeon.notes %></div>
      </div>
    <% end %>

    <% @surgeon.satisfaction_by_procedure.each do |procedure_id, satisfaction| %>
      <div class="panel panel-default">
        <div class="panel-heading">
          <h3 class="panel-title"><%= Procedure.find(procedure_id).name.to_s %>
          <%= link_to @pins_by_surgeon_procedure[procedure_id], pins_path(procedure: procedure_id, surgeon: @surgeon.id), { style: 'border-radius: 100%; background: #ffffcc; display:inline-block; padding:5px;' } %>
        </h3>
      </div>
      <div class="panel-body">
        <%= t('public.pin.average_satisfaction') %>: <%= satisfaction.to_i.to_s %>
      <label class="label-with-popover" data-placement="right" data-content="<%= t('public.pin.average_satisfaction') %>: <%= Procedure.find(procedure_id).avg_satisfaction %>" data-title="<%= t('public.pin.average_satisfaction') %>" data-trigger="hover" data-original-title="" title="">
        <%= fa_icon("bar-chart") %>
      </label>
    </div>
  </div>
<% end %>
</div>
</div>
<% end %>
