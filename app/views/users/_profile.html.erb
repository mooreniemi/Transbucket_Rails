<h2><%= title t('profile.edit_title', resource: resource_name.to_s.humanize) %></h2>
<div class="profile_well">
  <%= simple_form_for(resource, :as => resource_name, :url => registration_path(resource_name), :html => { :method => :put }) do |f| %>
    <%= render 'shared/errors', object: resource %>
  <div class="input-group">
    <span class="input-group-addon"><i class="glyphicon glyphicon-user"></i> <%= t('profile.name') %>: </span>
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <div class="input-group">
    <span class="input-group-addon"><%= fa_icon "users" %> <%= t('public.auth.username') %>: </span>
    <%= f.text_field :username, class: "form-control" %>
  </div>
  <div class="input-group">
    <span class="input-group-addon"><%= fa_icon "key" %> <%= t('public.auth.gender') %>: </span>
    <%= f.select :gender_id, localized_gender_options(resource.gender.id), {}, { class: "form-control"} %>
  </div>
  <small><%= t('profile.profile_help') %></small>
  <div class="input-group">
    <span class="input-group-addon"><i class="glyphicon glyphicon-envelope"></i> <%= t('profile.email') %>: </span>
    <%= f.email_field :email, class: "form-control" %>
  </div>
  <div class="input-group">
    <span class="input-group-addon"><%= fa_icon "lock" %> <%= t('public.auth.password') %>: </span>
    <%= f.password_field :password, placeholder: t('profile.new_password'), autocomplete: "off", class: "form-control" %>
    <%= f.password_field :password_confirmation, placeholder: t('public.auth.password_confirmation'), autocomplete: "off", class: "form-control" %>
    <%= f.password_field :current_password, placeholder: t('profile.current_password'), class: "form-control" %>
  </div>
  <div>
    <%= f.submit t('profile.update'), class: "btn btn-primary pull-right" %>
  <% end %>
    <br clear="both">
  </div>
</div>
