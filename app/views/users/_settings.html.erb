<% title t('settings.title') %>

<div class="profile_well">
  <%= simple_form_for(resource.preference, :url => user_preferences_path(resource), :html => {:method => :put, :class => 'form-horizontal'}) do |f| %>
    <%= render 'shared/errors', object: resource.preference %>
    <div class="col-lg-6">
      <div class="input-group">
        <span class="input-group-addon">
          <%= f.check_box :safe_mode, :value => resource.preference.safe_mode %>
        </span>
          <span class="form-control"><small><%= t('settings.safe_mode') %></small></span>
        <span class="input-group-addon"><i class="glyphicon glyphicon-eye-close"></i></span>
      </div><!-- /input-group -->
    </div><!-- /.col-lg-6 -->
    <div class="col-lg-6">
      <p><%= t('settings.safe_mode_help') %></p>
    </div>
    <div class="col-lg-6">
      <div class="input-group">
        <span class="input-group-addon">
          <%= f.check_box :notification, :value => resource.preference.notification  %>
        </span>
          <span class="form-control"><%= t('settings.notifications') %></span>
        <span class="input-group-addon"><i class="glyphicon glyphicon-envelope"></i></span>
      </div><!-- /input-group -->
    </div><!-- /.col-lg-6 -->
    <div class="col-lg-6">
      <p><%= t('settings.notifications_help') %></p>
    </div>
    <%= f.submit t('settings.update'), class: "btn btn-primary pull-right" %>
    <br clear="both">
  <% end %>
</div>
<h2><%= t('settings.cancel_account') %></h2>
<div class="well">
  <h3><%= t('settings.cancel_warning') %></h3>
  <%= button_to t('settings.cancel_account'), registration_path(resource_name), :data => { :confirm => t('settings.cancel_confirm') }, :method => :delete, :class => 'btn' %>
</div>
